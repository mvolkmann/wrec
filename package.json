{
  "name": "wrec",
  "version": "1.0.3",
  "description": "a library that greatly simplifies building web components",
  "keywords": [
    "component",
    "web"
  ],
  "license": "MIT",
  "author": "R. Mark Volkmann",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mvolkmann/wrec.git"
  },
  "bin": {
    "wrec-declare": "./scripts/declare.js",
    "wrec-lint": "./scripts/lint.js",
    "wrec-scaffold": "./scripts/scaffold.js",
    "wrec-usedby": "./scripts/used-by.js"
  },
  "files": [
    "dist",
    "scripts/ast-utils.js",
    "scripts/declare.js",
    "scripts/lint.js",
    "scripts/scaffold.js",
    "scripts/template.ts",
    "scripts/used-by.js",
    "README.md"
  ],
  "type": "module",
  "module": "./dist/wrec.es.js",
  "types": "./dist/wrec.d.ts",
  "exports": {
    ".": {
      "types": "./dist/wrec.d.ts",
      "browser": "./dist/wrec.es.js",
      "node": "./dist/wrec-ssr.es.js",
      "default": "./dist/wrec.es.js"
    },
    "./ssr": {
      "types": "./dist/wrec-ssr.d.ts",
      "import": "./dist/wrec-ssr.es.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "clean": "rm -rf dist",
    "format": "oxfmt",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node port-check.js && playwright test",
    "testui": "playwright test --ui",
    "unittest": "vitest run --maxWorkers=1"
  },
  "dependencies": {
    "@typescript/typescript6": "^6.0.2",
    "node-html-parser": "^9.0.3",
    "typescript": "^7.0.2",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.1",
    "get-port": "^7.2.0",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@12.3.4",
  "moduleResolution": "bundler"
}
